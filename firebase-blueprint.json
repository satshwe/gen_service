{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user account and RBAC role assignment.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "password": {
          "type": "string",
          "minLength": 4,
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["Administrator", "Chief Engineer", "Field Engineer", "Viewer"]
        },
        "department": {
          "type": "string",
          "maxLength": 120
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "password", "email", "displayName", "role", "department", "updatedAt"]
    },
    "InspectionSyncRecord": {
      "title": "InspectionSyncRecord",
      "description": "Cloud-synchronized generator inspection, servicing, breakdown, and activity record with conflict resolution metadata.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "reportNo": {
          "type": "string",
          "maxLength": 32
        },
        "centerId": {
          "type": "string",
          "maxLength": 64
        },
        "centerCode": {
          "type": "string",
          "maxLength": 32
        },
        "centerName": {
          "type": "string",
          "maxLength": 200
        },
        "generatorId": {
          "type": "string",
          "maxLength": 64
        },
        "kvaRating": {
          "type": "string",
          "maxLength": 64
        },
        "gensetModel": {
          "type": "string",
          "maxLength": 64
        },
        "inspectionDate": {
          "type": "string",
          "maxLength": 32
        },
        "inspectorName": {
          "type": "string",
          "maxLength": 120
        },
        "healthScore": {
          "type": "number"
        },
        "readinessStatus": {
          "type": "string",
          "enum": ["Ready", "Action Required", "Critical"]
        },
        "syncVersion": {
          "type": "number"
        },
        "clientUpdatedAtMs": {
          "type": "number"
        },
        "authorUid": {
          "type": "string",
          "maxLength": 128
        },
        "reportData": {
          "type": "object"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "reportNo",
        "centerId",
        "centerCode",
        "centerName",
        "generatorId",
        "kvaRating",
        "gensetModel",
        "inspectionDate",
        "inspectorName",
        "healthScore",
        "readinessStatus",
        "syncVersion",
        "clientUpdatedAtMs",
        "authorUid",
        "reportData",
        "updatedAt"
      ]
    },
    "AlertNotification": {
      "title": "AlertNotification",
      "description": "Real-time push and email notification event triggered by critical generator states or PM schedules.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "triggerType": {
          "type": "string",
          "enum": ["CRITICAL_READINESS", "BAD_CHECKLIST_ITEM", "MAINTENANCE_REMINDER"]
        },
        "severity": {
          "type": "string",
          "enum": ["Critical", "Warning", "Info"]
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "message": {
          "type": "string",
          "maxLength": 1000
        },
        "centerCode": {
          "type": "string",
          "maxLength": 32
        },
        "generatorId": {
          "type": "string",
          "maxLength": 64
        },
        "reportNo": {
          "type": "string",
          "maxLength": 32
        },
        "recipientsSummary": {
          "type": "string",
          "maxLength": 500
        },
        "emailDispatched": {
          "type": "boolean"
        },
        "read": {
          "type": "boolean"
        },
        "authorUid": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "triggerType",
        "severity",
        "title",
        "message",
        "centerCode",
        "generatorId",
        "reportNo",
        "recipientsSummary",
        "emailDispatched",
        "read",
        "authorUid",
        "createdAt"
      ]
    },
    "NotificationRuleConfig": {
      "title": "NotificationRuleConfig",
      "description": "Configuration for alert triggers and recipient email lists.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "triggerType": {
          "type": "string",
          "enum": ["CRITICAL_READINESS", "BAD_CHECKLIST_ITEM", "MAINTENANCE_REMINDER"]
        },
        "name": {
          "type": "string",
          "maxLength": 120
        },
        "enabled": {
          "type": "boolean"
        },
        "inAppPushEnabled": {
          "type": "boolean"
        },
        "emailEnabled": {
          "type": "boolean"
        },
        "recipientsCsv": {
          "type": "string",
          "maxLength": 1000
        },
        "updatedBy": {
          "type": "string",
          "maxLength": 128
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "triggerType",
        "name",
        "enabled",
        "inAppPushEnabled",
        "emailEnabled",
        "recipientsCsv",
        "updatedBy",
        "updatedAt"
      ]
    },
    "CenterAsset": {
      "title": "CenterAsset",
      "description": "Master Center facility record synchronized across all devices.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "centerCode": {
          "type": "string",
          "maxLength": 32
        },
        "centerName": {
          "type": "string",
          "maxLength": 200
        },
        "address": {
          "type": "string",
          "maxLength": 300
        },
        "township": {
          "type": "string",
          "maxLength": 120
        },
        "contactPerson": {
          "type": "string",
          "maxLength": 120
        },
        "contactPhone": {
          "type": "string",
          "maxLength": 64
        },
        "region": {
          "type": "string",
          "enum": ["Yangon", "Mandalay", "Naypyitaw", "Upper Myanmar", "Lower Myanmar"]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "centerCode",
        "centerName",
        "address",
        "township",
        "contactPerson",
        "contactPhone",
        "region",
        "updatedAt"
      ]
    },
    "GeneratorAssetRecord": {
      "title": "GeneratorAssetRecord",
      "description": "Master Generator equipment asset record synchronized across all devices.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "centerId": {
          "type": "string",
          "maxLength": 64
        },
        "centerCode": {
          "type": "string",
          "maxLength": 32
        },
        "generatorLabel": {
          "type": "string",
          "maxLength": 120
        },
        "kvaRating": {
          "type": "string",
          "maxLength": 64
        },
        "gensetModel": {
          "type": "string",
          "maxLength": 64
        },
        "gensetSerialNo": {
          "type": "string",
          "maxLength": 64
        },
        "engineModel": {
          "type": "string",
          "maxLength": 64
        },
        "engineSerialNo": {
          "type": "string",
          "maxLength": 64
        },
        "alternatorModel": {
          "type": "string",
          "maxLength": 64
        },
        "alternatorSerialNo": {
          "type": "string",
          "maxLength": 64
        },
        "controllerModel": {
          "type": "string",
          "maxLength": 64
        },
        "avrModel": {
          "type": "string",
          "maxLength": 64
        },
        "breakerType": {
          "type": "string",
          "enum": ["ACB", "MCCB"]
        },
        "breakerPoles": {
          "type": "string",
          "enum": ["3P", "4P"]
        },
        "breakerAmpRating": {
          "type": "string",
          "maxLength": 32
        },
        "status": {
          "type": "string",
          "enum": ["Active", "Standby", "Maintenance"]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "centerId",
        "centerCode",
        "generatorLabel",
        "kvaRating",
        "gensetModel",
        "gensetSerialNo",
        "engineModel",
        "engineSerialNo",
        "alternatorModel",
        "alternatorSerialNo",
        "controllerModel",
        "avrModel",
        "breakerType",
        "breakerPoles",
        "breakerAmpRating",
        "status",
        "updatedAt"
      ]
    },
    "AppConfigRecord": {
      "title": "AppConfigRecord",
      "description": "Cloud-synced application settings including Sector Directory, Admin Checklist Definitions, 300-Hr Servicing Tasks, and Center Email Overrides.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "configType": {
          "type": "string",
          "maxLength": 64
        },
        "configData": {
          "type": "object"
        },
        "updatedBy": {
          "type": "string",
          "maxLength": 128
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "configType", "configData", "updatedBy", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles and RBAC role assignments."
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/InspectionSyncRecord" },
      "description": "Synchronized generator inspection, servicing, breakdown, and activity records."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/AlertNotification" },
      "description": "Real-time push and email notification events."
    },
    "/notificationConfigs/{configId}": {
      "schema": { "$ref": "#/entities/NotificationRuleConfig" },
      "description": "Alert trigger and recipient configurations."
    },
    "/centers/{centerId}": {
      "schema": { "$ref": "#/entities/CenterAsset" },
      "description": "Master Center facility records."
    },
    "/generators/{generatorId}": {
      "schema": { "$ref": "#/entities/GeneratorAssetRecord" },
      "description": "Master Generator equipment asset records."
    },
    "/appConfigs/{configId}": {
      "schema": { "$ref": "#/entities/AppConfigRecord" },
      "description": "Cloud-synced Sector Names, Admin Form Customizations, and Center Email Rules."
    },
    "/test/{docId}": {
      "schema": { "$ref": "#/entities/AppConfigRecord" },
      "description": "Connection test probe document."
    }
  }
}
